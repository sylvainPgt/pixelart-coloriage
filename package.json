{
  "name": "mosaipix",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:image-crop": "node --experimental-strip-types tests/image-crop.test.mts",
    "test:crop-geometry": "node --experimental-strip-types tests/crop-geometry.test.mts",
    "test:rate-limit": "node --experimental-strip-types tests/rate-limit.test.mts",
    "test:e2e": "node tests/smoke.mjs",
    "test:pwa": "node tests/pwa.mjs",
    "assets:pwa": "node scripts/generate-pwa-assets.mjs",
    "screenshots:pwa": "node scripts/capture-pwa-screenshots.mjs",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:bundle": "cap sync android && cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.5",
    "ai": "^7.0.66",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "22.18.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "playwright": "^1.62.1",
    "typescript": "5.9.2"
  }
}
